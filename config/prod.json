{
  "environment": "production",
  "region": "eu-west-1",
  "project_name": "strava-ai-boost",
  "lambda_config": {
    "timeout": 180,
    "memory_size": 256,
    "log_level": "INFO",
    "enable_xray": false,
    "reserved_concurrency": 10
  },
  "dynamodb_config": {
    "billing_mode": "PAY_PER_REQUEST",
    "point_in_time_recovery": true,
    "deletion_protection": true,
    "stream_specification": {
      "stream_enabled": true,
      "stream_view_type": "NEW_AND_OLD_IMAGES"
    }
  },
  "step_functions_config": {
    "timeout": "PT15M",
    "log_level": "ERROR",
    "include_execution_data": false
  },
  "sqs_config": {
    "visibility_timeout": 600,
    "message_retention_period": 1209600,
    "max_receive_count": 3,
    "delay_seconds": 0
  },
  "api_gateway_config": {
    "throttle_rate_limit": 50,
    "throttle_burst_limit": 100,
    "enable_cors": true,
    "log_level": "ERROR"
  },
  "monitoring_config": {
    "enable_detailed_monitoring": false,
    "create_dashboards": true,
    "alarm_thresholds": {
      "error_rate": 0.02,
      "duration_threshold": 15000,
      "throttle_threshold": 5
    }
  },
  "agentcore_config": {
    "memory_name": "strava-ai-boost-memory-prod",
    "content_agent_name": "contentgen-prod",
    "campus_coach_agent_name": "campuscoach-prod",
    "ltm_strategy": "semantic_search",
    "max_memory_size": 2000,
    "memory_decay_rate": 0.05
  },
  "strava_config": {
    "rate_limits": {
      "short_term": 100,
      "daily": 1000
    },
    "webhook_verify_token": "strava-ai-boost-verify-token-prod"
  },
  "local_interface_config": {
    "host": "127.0.0.1",
    "port": 8000,
    "debug": false,
    "auto_reload": false
  }
}