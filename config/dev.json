{
  "environment": "development",
  "region": "eu-west-1",
  "project_name": "strava-ai-boost",
  "lambda_config": {
    "timeout": 300,
    "memory_size": 512,
    "log_level": "DEBUG",
    "enable_xray": true,
    "reserved_concurrency": null
  },
  "dynamodb_config": {
    "billing_mode": "PAY_PER_REQUEST",
    "point_in_time_recovery": false,
    "deletion_protection": false,
    "stream_specification": {
      "stream_enabled": true,
      "stream_view_type": "NEW_AND_OLD_IMAGES"
    }
  },
  "step_functions_config": {
    "timeout": "PT30M",
    "log_level": "ALL",
    "include_execution_data": true
  },
  "sqs_config": {
    "visibility_timeout": 900,
    "message_retention_period": 1209600,
    "max_receive_count": 3,
    "delay_seconds": 0
  },
  "api_gateway_config": {
    "throttle_rate_limit": 100,
    "throttle_burst_limit": 200,
    "enable_cors": true,
    "log_level": "INFO"
  },
  "monitoring_config": {
    "enable_detailed_monitoring": true,
    "create_dashboards": true,
    "alarm_thresholds": {
      "error_rate": 0.05,
      "duration_threshold": 30000,
      "throttle_threshold": 10
    }
  },
  "agentcore_config": {
    "memory_name": "strava-ai-boost-memory-dev",
    "content_agent_name": "contentgen-dev",
    "campus_coach_agent_name": "campuscoach-dev",
    "ltm_strategy": "semantic_search",
    "max_memory_size": 1000,
    "memory_decay_rate": 0.1
  },
  "strava_config": {
    "rate_limits": {
      "short_term": 100,
      "daily": 1000
    },
    "webhook_verify_token": "strava-ai-boost-verify-token-dev"
  },
  "local_interface_config": {
    "host": "127.0.0.1",
    "port": 8000,
    "debug": true,
    "auto_reload": true
  }
}