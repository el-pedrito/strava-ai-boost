        <mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1" parent="1"><mxGeometry height="1230" width="650" x="2080" y="30" as="geometry" /></mxCell>
        <mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry height="1170" width="602" x="2100" y="60" as="geometry" /></mxCell>
        <mxCell id="leg-1-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="0" as="geometry" /></mxCell>
        <mxCell id="leg-1-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;API surface&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The React app calls API Gateway with a Cognito JWT; API Lambdas serve dashboard, configuration and preferences from DynamoDB.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="80" width="548" x="52" y="0" as="geometry" /></mxCell>
        <mxCell id="leg-2-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="95" as="geometry" /></mxCell>
        <mxCell id="leg-2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Secrets, never in code&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Strava OAuth tokens and module credentials (Campus Coach, Intervals.icu) live in Secrets Manager; the pipeline refreshes tokens automatically.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="95" as="geometry" /></mxCell>
        <mxCell id="leg-3-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="205" as="geometry" /></mxCell>
        <mxCell id="leg-3-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Event pipeline&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Webhook (HMAC + anti-loop guards) to SQS + DLQ to Step Functions, which fetches the activity, runs both agents in parallel, merges and updates Strava.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="205" as="geometry" /></mxCell>
        <mxCell id="leg-4-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="315" as="geometry" /></mxCell>
        <mxCell id="leg-4-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Three runtimes, two models&lt;/b&gt;&lt;/div&gt;&lt;div&gt;content_gen writes in my style, coach talks trends, coach_chat answers questions with 5 tools over AG-UI streaming. Claude Sonnet 4.5 for rich generation, Haiku 4.5 for short tasks.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="110" width="548" x="52" y="315" as="geometry" /></mxCell>
        <mxCell id="leg-5-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="440" as="geometry" /></mxCell>
        <mxCell id="leg-5-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;One shared Memory&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A single LTM resource with 3 strategies (semantic, user preferences, episodic), unified namespaces, read by all three runtimes with session-type-aware queries.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="440" as="geometry" /></mxCell>
        <mxCell id="leg-6-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="550" as="geometry" /></mxCell>
        <mxCell id="leg-6-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Evaluations as a regression net&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Deterministic checks are the gates; managed LLM judges (built-ins + 2 custom) are signals. They replay 8 reference activities after every prompt change.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="550" as="geometry" /></mxCell>
        <mxCell id="leg-7-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="660" as="geometry" /></mxCell>
        <mxCell id="leg-7-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Observability built in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;CloudWatch GenAI dashboard: per-agent invocations, latency, tokens, X-Ray traces. Data protection masks passwords and auth headers in runtime logs.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="660" as="geometry" /></mxCell>
        <mxCell id="leg-8-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="770" as="geometry" /></mxCell>
        <mxCell id="leg-8-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Campus Coach sync&lt;/b&gt;&lt;/div&gt;&lt;div&gt;EventBridge every 2h (05:00-21:00 UTC, 9 runs/day): REST login + smart-training pulls up to 9 weeks of structured sessions into DynamoDB. Replaced the Browser Tool agent.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="770" as="geometry" /></mxCell>
        <mxCell id="leg-9-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="880" as="geometry" /></mxCell>
        <mxCell id="leg-9-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Voice features&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Per-activity audio debrief (Haiku script) and a Sunday-evening weekly recap (Sonnet script), both through Polly Generative (Ambre). MP3s in S3, served via presigned URLs.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="880" as="geometry" /></mxCell>
        <mxCell id="leg-10-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="990" as="geometry" /></mxCell>
        <mxCell id="leg-10-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The learning loop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A nightly Lambda diffs my manual edits against the generated text (similarity threshold 99.5%); the preference strategy in Memory consolidates my style over time.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="990" as="geometry" /></mxCell>
        <mxCell id="legend-note" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="Dashed arrows = evaluation, traces and learning paths. 8 CDK stacks, 18 Lambdas, ~$5/month." vertex="1" parent="legend-container"><mxGeometry height="60" width="548" x="52" y="1100" as="geometry" /></mxCell>
