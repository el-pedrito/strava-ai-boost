        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;exitX=0.75;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="grp-front" target="grp-chat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="1250" /><mxPoint x="1660" y="1250" /><mxPoint x="1660" y="570" /></Array></mxGeometry></mxCell>
        <mxCell id="e16-l" value="coach chat: AG-UI SSE, direct to the runtime (Cognito JWT, no proxy)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontFamily=Helvetica;fontSize=11;" connectable="0" vertex="1" parent="e16"><mxGeometry relative="1" x="-0.5" y="0" as="geometry"><mxPoint x="0" y="16" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;dashed=1;exitX=1;exitY=0.5;entryX=0.75;entryY=1;" edge="1" parent="1" source="grp-feedback" target="grp-memory"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="1130" /><mxPoint x="1330" y="700" /><mxPoint x="1190" y="700" /></Array></mxGeometry></mxCell>
        <mxCell id="e17-l" value="my edits teach it my style" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontFamily=Helvetica;fontSize=11;fontStyle=2;" connectable="0" vertex="1" parent="e17"><mxGeometry relative="1" x="-0.75" y="0" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;exitX=0.5;exitY=0;entryX=0.833;entryY=1;" edge="1" parent="1" source="grp-chat" target="grp-ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18-l" value="5 tools read live data" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontFamily=Helvetica;fontSize=11;" connectable="0" vertex="1" parent="e18"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="72" y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="1" vertex="1" parent="1"><mxGeometry x="10" y="666" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="2" vertex="1" parent="1"><mxGeometry x="352" y="192" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="3" vertex="1" parent="1"><mxGeometry x="1032" y="192" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="4" vertex="1" parent="1"><mxGeometry x="704" y="748" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="5" vertex="1" parent="1"><mxGeometry x="250" y="806" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="6" vertex="1" parent="1"><mxGeometry x="1584" y="836" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="7" vertex="1" parent="1"><mxGeometry x="1400" y="466" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="step-8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="8" vertex="1" parent="1"><mxGeometry x="726" y="1032" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1" parent="1"><mxGeometry height="1050" width="650" x="2080" y="30" as="geometry" /></mxCell>
        <mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry height="990" width="602" x="2100" y="60" as="geometry" /></mxCell>
        <mxCell id="leg-1-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="0" as="geometry" /></mxCell>
        <mxCell id="leg-1-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;A run lands on Strava&lt;/b&gt;&lt;/div&gt;&lt;div&gt;I upload an activity; Strava pushes a webhook. The handler validates the HMAC signature and answers in under 5 seconds.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="80" width="548" x="52" y="0" as="geometry" /></mxCell>
        <mxCell id="leg-2-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="95" as="geometry" /></mxCell>
        <mxCell id="leg-2-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Buffered, never lost&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The event goes to SQS; failures land in a DLQ and can be replayed. Guards prevent the update-webhook infinite loop.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="80" width="548" x="52" y="95" as="geometry" /></mxCell>
        <mxCell id="leg-3-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="190" as="geometry" /></mxCell>
        <mxCell id="leg-3-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Orchestration&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Step Functions fetches the activity + device laps, then runs the two agents in parallel branches. A coach failure never blocks the enhancement.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="80" width="548" x="52" y="190" as="geometry" /></mxCell>
        <mxCell id="leg-4-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="285" as="geometry" /></mxCell>
        <mxCell id="leg-4-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Two agents, two jobs&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The content agent writes the title + description in my style; the coach agent reads 4 weeks of history and talks trends, not recaps. Claude Sonnet 4.5 behind a Bedrock Guardrail.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="285" as="geometry" /></mxCell>
        <mxCell id="leg-5-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="395" as="geometry" /></mxCell>
        <mxCell id="leg-5-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;External training context&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The Campus Coach plan (REST sync every 2h) and Intervals.icu fitness (CTL, form, HRV) are fetched by code and matched deterministically. Only the best candidate reaches the LLM.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="395" as="geometry" /></mxCell>
        <mxCell id="leg-6-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="505" as="geometry" /></mxCell>
        <mxCell id="leg-6-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Back to Strava&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Assembly merges both outputs and updates the activity. State and results live in DynamoDB (4 tables, query-only access patterns).&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="80" width="548" x="52" y="505" as="geometry" /></mxCell>
        <mxCell id="leg-7-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="600" as="geometry" /></mxCell>
        <mxCell id="leg-7-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Agentic coach chat&lt;/b&gt;&lt;/div&gt;&lt;div&gt;The browser streams AG-UI over SSE straight to the coach_chat runtime (Cognito JWT authorizer, no proxy Lambda). Its 5 tools fetch exactly the data each question needs, token by token.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="95" width="548" x="52" y="600" as="geometry" /></mxCell>
        <mxCell id="leg-8-badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="legend-container"><mxGeometry height="38" width="40" y="710" as="geometry" /></mxCell>
        <mxCell id="leg-8-desc" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;The passive learning loop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A nightly Lambda diffs my manual edits against the generated text; the shared Memory (semantic, user preferences, episodic) learns my writing style from them. Zero friction: I just edit as I always would.&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="110" width="548" x="52" y="710" as="geometry" /></mxCell>
        <mxCell id="legend-note" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="Dashed arrow = learning loop. One AgentCore Memory shared by all three runtimes. ~$5/month, 717 tests, MIT-0." vertex="1" parent="legend-container"><mxGeometry height="60" width="548" x="52" y="840" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
